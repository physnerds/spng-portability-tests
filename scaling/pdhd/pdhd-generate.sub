# Optional first workflow stage. Submit only when DATASET is not already ready.
# Export PROJECT_DIR, DATASET, IMAGE, RESULTS_DIR, and DEPOS first.
universe = vanilla

project_dir = $ENV(PROJECT_DIR)
dataset = $ENV(DATASET)
image = $ENV(IMAGE)
results_dir = $ENV(RESULTS_DIR)
depos = $ENV(DEPOS)

# Override these on condor_submit's command line when needed.
dataset_events = 32
source_events = 1
repeat_input = 1

executable = $(project_dir)/scaling/pdhd/pdhd-condor-generate.sh
arguments = $(ClusterId).$(ProcId)

request_gpus = 0
request_cpus = 1
request_memory = 8GB
request_disk = 2GB
should_transfer_files = NO

initialdir = $(project_dir)
log = condor-logs/pdhd-generation-$(ClusterId).log
output = condor-logs/pdhd-generation-$(ClusterId).$(ProcId).out
error = condor-logs/pdhd-generation-$(ClusterId).$(ProcId).err

environment = "PROJECT_DIR=$(project_dir) DATASET=$(dataset) IMAGE=$(image) RESULTS_DIR=$(results_dir) DEPOS=$(depos) DATASET_EVENTS=$(dataset_events) SOURCE_EVENTS=$(source_events) REPEAT_INPUT=$(repeat_input)"
notification = Error
queue 1
