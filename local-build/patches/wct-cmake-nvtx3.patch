diff --git a/CMakeLists.txt b/CMakeLists.txt
index 04e7ee0e..9224a0ca 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -56,6 +56,8 @@ set_property(CACHE WCT_SPDLOG_ACTIVE_LEVEL PROPERTY STRINGS
              trace debug info warn error critical off)
 
 # Tests are off by default (mirrors waf's --tests opt-in); wired up in wct-ike.9.
+option(WCT_WITH_NVTX "Enable NVTX3 profiling annotations" OFF)
+
 option(WCT_WITH_TESTS "Build and register the test suite (mirrors --tests)" OFF)
 
 # The experimental WireCellSpng package only builds against a recent libtorch
diff --git a/cmake/WCTBuildConfig.cmake b/cmake/WCTBuildConfig.cmake
index fd1e009f..db985070 100644
--- a/cmake/WCTBuildConfig.cmake
+++ b/cmake/WCTBuildConfig.cmake
@@ -50,7 +50,8 @@ set(_wct_have_map
     "PYTHON:HAVE,LIB,INC"
     "ROOTSYS:HAVE"
     "LIBTORCH:HAVE"
-    "CUDA:HAVE")
+    "CUDA:HAVE"
+    "NVTX:HAVE")
 
 set(_lines "")
