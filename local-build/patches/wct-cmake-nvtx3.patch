diff --git a/cmake/WCTDependencies.cmake b/cmake/WCTDependencies.cmake
index 6a367caf..00b43071 100644
--- a/cmake/WCTDependencies.cmake
+++ b/cmake/WCTDependencies.cmake
@@ -181,6 +181,18 @@ function(_wct_missing tok)
   set(WCT_EXTERNAL_MISSING "${WCT_EXTERNAL_MISSING}" CACHE INTERNAL "")
 endfunction()
 
+# NVTX3 is header-only and is supplied by the CUDA toolkit.
+if(WCT_WITH_NVTX)
+  find_path(WCT_NVTX_INCLUDE_DIR NAMES nvToolsExt.h
+    HINTS "${CUDAToolkit_ROOT}/include/nvtx3" "$ENV{CUDA_HOME}/include/nvtx3"
+    PATH_SUFFIXES nvtx3 include/nvtx3)
+  if(NOT WCT_NVTX_INCLUDE_DIR)
+    message(FATAL_ERROR "WCT_WITH_NVTX requires NVTX3 headers (set WCT_NVTX_INCLUDE_DIR)")
+  endif()
+  _wct_provide(NVTX INCLUDE "${WCT_NVTX_INCLUDE_DIR}" LINK "${CMAKE_DL_LIBS}")
+  set_property(TARGET WCT::NVTX PROPERTY INTERFACE_COMPILE_DEFINITIONS HAVE_NVTX=1)
+endif()
+
 # ===========================================================================
 # Mandatory dependencies
 # ===========================================================================
