# syntax=docker/dockerfile:1.7

ARG NERSC_PYTORCH_IMAGE=docker.io/nersc/pytorch:24.08.01
FROM ${NERSC_PYTORCH_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG SPACK_REF=v1.0.0
ARG WIRECELL_SPACK_REF=master

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}
ENV http_proxy=${HTTP_PROXY}
ENV https_proxy=${HTTPS_PROXY}
ENV no_proxy=${NO_PROXY}

ENV SPACK_ROOT=/opt/spack
ENV SPACK_USER_CACHE_PATH=/opt/spack-cache/user
ENV SPACK_DISABLE_LOCAL_CONFIG=true

ENV PATH=/opt/spack/bin:/usr/local/cuda/bin:${PATH}

# ----------------------------------------------------------------------
# Install only system tools required by Spack/Wire-Cell.
#
# GCC, CUDA, Python and PyTorch already come from the NERSC image.
# ----------------------------------------------------------------------
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        bzip2 \
        ca-certificates \
        curl \
        diffutils \
        file \
        findutils \
        gfortran \
        git \
        gzip \
        hostname \
        make \
        patch \
        tar \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------------
# Verify the software stack inherited from the NERSC image.
# ----------------------------------------------------------------------
RUN set -euo pipefail; \
    echo "=== GCC ==="; \
    gcc --version; \
    g++ --version; \
    gfortran --version; \
    echo "=== CUDA ==="; \
    nvcc --version; \
    echo "=== Python / PyTorch ==="; \
    python - <<'PY'
import torch
print("Python PyTorch module:", torch.__file__)
print("PyTorch version:", torch.__version__)
print("PyTorch CUDA:", torch.version.cuda)
print("CXX11 ABI:", torch.compiled_with_cxx11_abi())
print("CMake prefix:", torch.utils.cmake_prefix_path)
PY

# ----------------------------------------------------------------------
# Install Spack.
# ----------------------------------------------------------------------
RUN git clone https://github.com/spack/spack.git "${SPACK_ROOT}" \
    && git -C "${SPACK_ROOT}" checkout "${SPACK_REF}"

# ----------------------------------------------------------------------
# Wire-Cell Spack repository.
# ----------------------------------------------------------------------
RUN git clone \
        https://github.com/WireCell/wire-cell-spack.git \
        /opt/wire-cell-spack \
    && git -C /opt/wire-cell-spack checkout "${WIRECELL_SPACK_REF}"

RUN mkdir -p \
        /opt/wirecell-env \
        /opt/wirecell-view \
        /opt/spack-install \
        /opt/spack-cache \
        /opt/spack-stage

COPY spack.yaml /opt/wirecell-env/spack.yaml

# ----------------------------------------------------------------------
# Register the compiler from the NERSC image.
# ----------------------------------------------------------------------
RUN source "${SPACK_ROOT}/share/spack/setup-env.sh" \
    && spack -e /opt/wirecell-env compiler find \
        --scope env:/opt/wirecell-env \
        /usr \
    && spack -e /opt/wirecell-env compilers

# ----------------------------------------------------------------------
# Concretize.
# ----------------------------------------------------------------------
RUN source "${SPACK_ROOT}/share/spack/setup-env.sh" \
    && spack -e /opt/wirecell-env concretize --fresh \
    && spack -e /opt/wirecell-env spec -Il

# ----------------------------------------------------------------------
# Install the non-Torch Wire-Cell dependencies.
# ----------------------------------------------------------------------
RUN source "${SPACK_ROOT}/share/spack/setup-env.sh" \
    && spack -e /opt/wirecell-env install \
        --fail-fast \
        --show-log-on-error \
        --no-checksum

# Generate the unified Spack view.
RUN source "${SPACK_ROOT}/share/spack/setup-env.sh" \
    && spack -e /opt/wirecell-env env view enable /opt/wirecell-view \
    && spack -e /opt/wirecell-env env view regenerate

# ----------------------------------------------------------------------
# Final verification.
#
# This is particularly important: there should be NO Spack py-torch.
# ----------------------------------------------------------------------
RUN source "${SPACK_ROOT}/share/spack/setup-env.sh" \
    && echo "=== Spack dependency image contents ===" \
    && spack -e /opt/wirecell-env find -dlv \
    && echo "=== Checking that PyTorch was not installed by Spack ===" \
    && if spack -e /opt/wirecell-env find --format '{name}' | grep -qx py-torch; then \
           echo "ERROR: Spack py-torch unexpectedly exists"; \
           exit 1; \
       else \
           echo "OK: no Spack py-torch"; \
       fi \
    && echo "=== NERSC PyTorch ===" \
    && python - <<'PY'
import torch
print("Torch:", torch.__version__)
print("Torch location:", torch.__path__[0])
print("Torch CUDA:", torch.version.cuda)
PY